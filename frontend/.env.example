# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real values here.

# Base URL of the Lore backend (FastAPI). The frontend calls this for every
# /ingest and /chat request — see src/api/client.ts.
#
# Local dev (backend running via `uvicorn app.main:app --port 8000`):
VITE_API_URL=http://localhost:8000

# Deployed (Vercel): set this to your Render backend's public URL instead,
# e.g. VITE_API_URL=https://lore-backend.onrender.com
# This MUST be set as an environment variable in the Vercel project
# settings — if it's missing, the deployed frontend falls back to
# localhost:8000, which doesn't exist in the browser and every request
# will fail silently. See DEPLOYMENT.md.