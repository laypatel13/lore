# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# GitHub API token (increases rate limits for ingestion)
GITHUB_TOKEN=

# LLM provider key(s) used for synthesis — only GROQ_API_KEY is required
# for the default (graph_mode=False) fast local-embedding pipeline.
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_API_KEY=

# Cognee (only needed when graph_mode=True)
COGNEE_API_KEY=
COGNEE_SKIP_CONNECTION_TEST=true

APP_ENV=development


COGNEE_CLOUD_URL=
COGNEE_API_KEY=